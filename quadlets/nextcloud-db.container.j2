[Container]
Image={{ nextcloud_service_db_image }}
ContainerName=nextcloud-db
EnvironmentFile=./configs/nextcloud.env
Secret=nextcloud_service_db_password,type=mount,target=/run/secrets/nextcloud_service_db_password
Volume={{ service_home }}/data/db_data:/var/lib/postgresql/data:Z
PodmanArgs={{ nextcloud_service_db_extra_args }}
Pod=nc.pod
AutoUpdate={{ nextcloud_service_auto_update }}
HealthCmd=pg_isready -U {{ nextcloud_service_db_user }}
HealthInterval=30s
HealthStartPeriod=60s
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
