[Container]
Image={{ nextcloud_service_db_image }}
ContainerName=nextcloud-db
EnvironmentFile=./configs/db.env
Secret=nextcloud_service_db_password
Volume={{ service_home }}/data/db_data:/var/lib/postgresql/data:Z
# the entrypoint fixes the data dir, then gosu postgres.
AddCapability=CHOWN DAC_OVERRIDE FOWNER SETGID SETUID
# The SSD and autovacuum part of Nextcloud AIO's tuning. Its larger work_mem
# and maintenance_work_mem do not fit the memory ceiling. shared_buffers and
# the pod's /dev/shm count against that ceiling.
Exec=postgres -c shared_buffers=256MB -c effective_cache_size=1GB -c random_page_cost=1.1 -c effective_io_concurrency=200 -c checkpoint_timeout=15min -c autovacuum_vacuum_scale_factor=0.05 -c autovacuum_analyze_scale_factor=0.02
# TCP, not the socket: the entrypoint's temporary first-start server listens
# on the socket alone.
HealthCmd=pg_isready -h 127.0.0.1 -U nextcloud
HealthInterval=10s
# Nine failed checks in a row, 90 s, before the kill: a stall under memory
# pressure is no reason to kill Postgres during a dump.
HealthRetries=9
HealthStartPeriod=300s
HealthOnFailure=kill
# Podman's 10 s kill would force a crash recovery after each nightly update.
StopTimeout=120
# The app starts only once the database accepts connections, also after the
# crash recovery of a restored data directory.
Notify=healthy

[Service]
# The start covers the image pull, the relabel of db_data (:Z) and the
# first start or the crash recovery.
TimeoutStartSec=300
TimeoutStopSec=150
