[Unit]
Requires=nextcloud-db.service nextcloud-redis.service
After=nextcloud-db.service nextcloud-redis.service

[Container]
Image={{ nextcloud_service_app_image }}
ContainerName=nextcloud-app
EnvironmentFile=./configs/nextcloud.env
Secret=nextcloud_service_db_password,type=mount,target=/run/secrets/nextcloud_service_db_password
Secret=nextcloud_service_admin_password,type=mount,target=/run/secrets/nextcloud_service_admin_password
PodmanArgs={{ nextcloud_service_app_extra_args }}
Volume=nc-app-html:/var/www/html:z
Volume={{ service_home }}/data/custom_apps:/var/www/html/custom_apps:z
Volume={{ service_home }}/data/data:/var/www/html/data:z
Volume={{ service_home }}/data/config:/var/www/html/config:z
Volume=/dev/log:/dev/log
Pod=nc.pod
AutoUpdate={{ nextcloud_service_auto_update }}

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
