[Container]
Image={{ nextcloud_app_image }}
ContainerName=nextcloud-cron
EnvironmentFile=./configs/nextcloud.env
Secret=nextcloud_db_password,type=mount,target=/run/secrets/nextcloud_db_password
PodmanArgs={{ nextcloud_service_cron_extra_args }}
Volume=nc-app-html:/var/www/html:z
Volume={{ service_home }}/data/custom_apps:/var/www/html/custom_apps:z
Volume={{ service_home }}/data/data:/var/www/html/data:z
Volume={{ service_home }}/data/config:/var/www/html/config:z
Pod=nc.pod
# Sets up the previewgenerator app, then runs cron.sh (cron.php + preview:pre-generate)
Entrypoint=/previewgenerator.sh
AutoUpdate={{ nextcloud_service_auto_update }}

[Unit]
After=nextcloud-app.service

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
