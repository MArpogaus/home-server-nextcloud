{
  "uid": "nextcloud",
  "title": "Nextcloud",
  "tags": [
    "home-server"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Boots",
        "expr": "{job=\"systemd-journal\", unit=\"init.scope\"} |= \"Startup finished in\"",
        "titleFormat": "Boot",
        "textFormat": "Startup finished"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "title": "Requests/min",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"nextcloud\", syslog_identifier=\"nextcloud_nginx\"} | json | __error__=\"\" | request_uri != \"/status.php\" [1h])) / 60 or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "Requests that reached nginx in the last hour, health checks excluded.",
      "id": 2
    },
    {
      "title": "p95",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 3,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {service=\"nextcloud\", syslog_identifier=\"nextcloud_nginx\"} | json | __error__=\"\" | request_uri != \"/status.php\" | status != \"101\" | unwrap request_time [1h]) by (job)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "no requests",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "95 % of requests in the last hour were faster than this.",
      "id": 3
    },
    {
      "title": "5xx (1h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"nextcloud\", syslog_identifier=\"nextcloud_nginx\"} | json | __error__=\"\" | request_uri != \"/status.php\" | status =~ \"5..\" [1h])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "Errors nginx answered in the last hour, mostly 504 timeouts or 502 from a full worker pool.",
      "id": 4
    },
    {
      "title": "Bad logins",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"nextcloud\", syslog_identifier=\"nextcloud\"} |= \"Login failed: '\" [24h])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "Failed logins, wrong password or unknown user.",
      "id": 5
    },
    {
      "title": "App warnings",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"nextcloud\", syslog_identifier=\"nextcloud\"} | json level | level >= 2 [24h])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "Nextcloud log entries at level 2 warning and above.",
      "id": 6
    },
    {
      "title": "FPM maxed",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"nextcloud\", syslog_identifier=\"nextcloud-php-fpm\"} |= \"reached pm.max_children\" [24h])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "Every hit means queued requests; raise nextcloud_service_php_max_children if it is not zero at quiet times.",
      "id": 7
    },
    {
      "title": "Cron (30m)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"nextcloud\", syslog_identifier=\"crond\"} |= \"cmd php -f /var/www/html/cron.php\" [30m])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "cron.php runs in the last 30 minutes; it starts every 5 minutes.",
      "id": 26
    },
    {
      "title": "Fatal (24h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 21,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(count_over_time({service=\"nextcloud\", user_unit=\"nextcloud-db.service\"} |= \"PANIC\" [24h])) or vector(0)) + (sum(count_over_time({service=\"nextcloud\", syslog_identifier=\"nextcloud\"} | json level | level >= 4 [24h])) or vector(0))",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "description": "PostgreSQL PANIC lines plus Nextcloud fatal log entries.",
      "id": 27
    },
    {
      "type": "row",
      "title": "Trends",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 8
    },
    {
      "title": "Requests by class",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (class) (count_over_time({service=\"nextcloud\", syslog_identifier=\"nextcloud_nginx\"} | json | __error__=\"\" | request_uri != \"/status.php\" | label_format class=\"{{ .status | substr 0 1 }}xx\" [$__auto]))",
          "legendFormat": "{{class}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Requests per interval by status class; 4xx includes 401 from clients that renew their session.",
      "id": 9
    },
    {
      "title": "Response time",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "label_replace(quantile_over_time(0.5, {service=\"nextcloud\", syslog_identifier=\"nextcloud_nginx\"} | json | __error__=\"\" | request_uri != \"/status.php\" | status != \"101\" | unwrap request_time [$__auto]) by (job), \"series\", \"p50 \u2013 median\", \"\", \"\")",
          "legendFormat": "{{series}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "label_replace(quantile_over_time(0.95, {service=\"nextcloud\", syslog_identifier=\"nextcloud_nginx\"} | json | __error__=\"\" | request_uri != \"/status.php\" | status != \"101\" | unwrap request_time [$__auto]) by (job), \"series\", \"p95\", \"\", \"\")",
          "legendFormat": "{{series}}",
          "queryType": "range",
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "label_replace(max_over_time({service=\"nextcloud\", syslog_identifier=\"nextcloud_nginx\"} | json | __error__=\"\" | request_uri != \"/status.php\" | status != \"101\" | unwrap request_time [$__auto]) by (job), \"series\", \"max \u2013 slowest request\", \"\", \"\")",
          "legendFormat": "{{series}}",
          "queryType": "range",
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max \u2013 slowest request"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Median, p95 and maximum nginx request_time; the push websocket is left out.",
      "id": 10
    },
    {
      "title": "Clients",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (client) (count_over_time({service=\"nextcloud\", syslog_identifier=\"nextcloud_nginx\"} | json request_uri, http_user_agent | __error__=\"\" | request_uri != \"/status.php\" | label_format client=`{{ $a := .http_user_agent }}{{ if contains \"mirall\" $a }}desktop{{ else if contains \"Nextcloud-android\" $a }}android{{ else if contains \"Nextcloud-iOS\" $a }}ios{{ else if contains \"DAVx5\" $a }}DAVx5{{ else if contains \"Thunderbird\" $a }}Thunderbird{{ else if contains \"Mozilla\" $a }}browser{{ else }}other{{ end }}` [$__auto]))",
          "legendFormat": "{{client}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Requests per interval by user agent family.",
      "id": 11
    },
    {
      "title": "Bytes sent",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "label_replace(sum(sum_over_time({service=\"nextcloud\", syslog_identifier=\"nextcloud_nginx\"} | json | __error__=\"\" | request_uri != \"/status.php\" | unwrap bytes_sent [$__auto])), \"series\", \"sent to clients\", \"\", \"\")",
          "legendFormat": "{{series}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Bytes nginx sent per interval; the legend shows the total over the range.",
      "id": 12
    },
    {
      "type": "row",
      "title": "Details",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 13
    },
    {
      "title": "Top paths",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "expr": "topk(10, sum by (path) (count_over_time({service=\"nextcloud\", syslog_identifier=\"nextcloud_nginx\"} | json | __error__=\"\" | request_uri != \"/status.php\" | label_format path=\"{{ regexReplaceAll \\\"^(/[^/?]*(/[^/?]*)?).*\\\" .request_uri \\\"${1}\\\" }}\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
