# Templated by Ansible. Values come from the role defaults.
POSTGRES_DB={{ nextcloud_service_db_name }}
POSTGRES_USER={{ nextcloud_service_db_user }}
POSTGRES_PASSWORD_FILE=/run/secrets/nextcloud_service_db_password
PGDATA=/var/lib/postgresql/data/pgdata

REDIS_HOST=127.0.0.1
POSTGRES_HOST=127.0.0.1
NEXTCLOUD_TRUSTED_DOMAINS={{ nextcloud_service_trusted_domains }}
TRUSTED_PROXIES={{ nextcloud_service_trusted_proxies }}
NEXTCLOUD_ADMIN_USER={{ nextcloud_service_admin_user }}
NEXTCLOUD_ADMIN_PASSWORD_FILE=/run/secrets/nextcloud_service_admin_password
NEXTCLOUD_URL={{ nextcloud_service_url }}

# configure.sh derives start and spare servers from PHP_MAX_CHILDREN.
PHP_MAX_CHILDREN={{ nextcloud_service_php_max_children }}
PHP_MAX_REQUESTS={{ nextcloud_service_php_max_requests }}
PHP_MAX_EXECUTION_TIME={{ nextcloud_service_php_max_execution_time }}
PHP_UPLOAD_LIMIT={{ nextcloud_service_php_upload_limit }}
PHP_MEMORY_LIMIT={{ nextcloud_service_php_memory_limit }}
PHP_MAX_FILE_UPLOADS={{ nextcloud_service_php_max_file_uploads }}
PHP_EMERGENCY_RESTART_THRESHOLD={{ nextcloud_service_php_emergency_restart_threshold }}
PHP_EMERGENCY_RESTART_INTERVAL={{ nextcloud_service_php_emergency_restart_interval }}
PHP_PROCESS_CONTROL_TIMEOUT={{ nextcloud_service_php_process_control_timeout }}
NOTIFY_PUSH_ARCH={{ nextcloud_service_notify_push_arch }}
