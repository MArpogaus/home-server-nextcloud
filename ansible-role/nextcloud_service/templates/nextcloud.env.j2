# Nextcloud Environment — templated by Ansible
# Values come from the role defaults, overridden in secrets/vars.yml.

# Database
POSTGRES_DB={{ nextcloud_db_name }}
POSTGRES_USER={{ nextcloud_db_user }}
POSTGRES_PASSWORD={{ nextcloud_db_password }}
PGDATA=/var/lib/postgresql/data/pgdata

# Application
REDIS_HOST=127.0.0.1
POSTGRES_HOST=127.0.0.1
NEXTCLOUD_TRUSTED_DOMAINS={{ nextcloud_trusted_domains }}
TRUSTED_PROXIES={{ nextcloud_trusted_proxies }}
NEXTCLOUD_ADMIN_USER={{ nextcloud_admin_user }}
NEXTCLOUD_ADMIN_PASSWORD={{ nextcloud_admin_password }}
NEXTCLOUD_URL={{ nextcloud_url }}

# PHP-FPM (configure.sh derives start/spare servers from PHP_MAX_CHILDREN)
PHP_MAX_CHILDREN={{ nextcloud_php_max_children }}
PHP_MAX_REQUESTS={{ nextcloud_php_max_requests }}
PHP_MAX_EXECUTION_TIME={{ nextcloud_php_max_execution_time }}
PHP_UPLOAD_LIMIT={{ nextcloud_php_upload_limit }}
PHP_MEMORY_LIMIT={{ nextcloud_php_memory_limit }}
PHP_MAX_FILE_UPLOADS={{ nextcloud_php_max_file_uploads }}
PHP_EMERGENCY_RESTART_THRESHOLD={{ nextcloud_php_emergency_restart_threshold }}
PHP_EMERGENCY_RESTART_INTERVAL={{ nextcloud_php_emergency_restart_interval }}
PHP_PROCESS_CONTROL_TIMEOUT={{ nextcloud_php_process_control_timeout }}
NOTIFY_PUSH_ARCH={{ nextcloud_notify_push_arch }}
