#!/bin/bash
# Dumps into the data subvolume, so the nightly Btrfs snapshot captures a
# consistent database instead of its on-disk files mid-write.
set -euo pipefail

DUMP_DIR="${HOME}/data/db_dumps"
TIMESTAMP="$(date +%F-%H%M%S)"
DUMP_FILE="${DUMP_DIR}/dump-${TIMESTAMP}.sql"

mkdir -p "$DUMP_DIR"
rm -f "$DUMP_DIR"/*.tmp

# Written under a name the snapshot and the restore ignore, renamed when
# pg_dumpall has exited 0: a dump that died halfway must not look complete.
# No password: the local Unix socket is trusted by the postgres image.
podman exec -u postgres nextcloud-db \
	pg_dumpall -U {{ nextcloud_service_db_user }} > "${DUMP_FILE}.tmp"
mv "${DUMP_FILE}.tmp" "$DUMP_FILE"

echo "Dump saved: ${DUMP_FILE} ($(wc -c < "$DUMP_FILE") bytes)"

find "$DUMP_DIR" -name 'dump-*.sql' -mtime +{{ nextcloud_service_db_dump_retention_days }} -delete
