#!/bin/bash
# Pre-snapshot PostgreSQL dump — runs as the nextcloud user.
# Dumps into the data subvolume so the nightly Btrfs snapshot captures a
# consistent copy of the database rather than its on-disk files mid-write.
set -euo pipefail

DUMP_DIR="${HOME}/data/db_dumps"
TIMESTAMP="$(date +%F-%H%M%S)"
DUMP_FILE="${DUMP_DIR}/dump-${TIMESTAMP}.sql"

mkdir -p "$DUMP_DIR"

# No password needed: this connects over the container's local Unix socket,
# which the postgres image trusts. Reading the podman secret here would put the
# password back into a process argument, which is what the secret avoids.
podman exec -u postgres nextcloud-db \
	pg_dumpall -U {{ nextcloud_db_user }} > "$DUMP_FILE"

if [ ! -s "$DUMP_FILE" ]; then
	echo "ERROR: dump is empty, removing ${DUMP_FILE}" >&2
	rm -f "$DUMP_FILE"
	exit 1
fi

echo "Dump saved: ${DUMP_FILE} ($(wc -c < "$DUMP_FILE") bytes)"

find "$DUMP_DIR" -name 'dump-*.sql' -mtime +{{ nextcloud_db_dump_retention_days }} -delete
